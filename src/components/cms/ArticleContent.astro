---
import { PortableText } from 'emdash/ui';
import type { PortableTextBlock } from 'emdash';
import Heading from './Heading.astro';
import Code from './Code.astro';
import Widget from './Widget.astro';
import Tabs from './Tabs.astro';
import Tweet from './Tweet.astro';

interface Props {
  value: PortableTextBlock[];
}
const { value } = Astro.props;
---

<div class="cms-prose">
  <PortableText
    value={value}
    components={{ block: Heading, type: { code: Code, zephyrComponent: Widget, zephyrTabs: Tabs, zephyrTweet: Tweet } }}
  />
</div>

<style is:global>
  .cms-prose p {
    margin-bottom: 1.25rem;
  }
  .cms-prose ul,
  .cms-prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .cms-prose ul {
    list-style: disc;
  }
  .cms-prose ol {
    list-style: decimal;
  }
  .cms-prose li {
    padding-left: 0.375rem;
    margin-top: 0.5rem;
  }
  .cms-prose li::marker {
    color: var(--ze-ink-faint);
  }
  .cms-prose a {
    color: var(--ze-released-ink);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
    text-decoration-color: rgb(182 157 255 / 0.35);
  }
  .cms-prose a:hover {
    text-decoration-color: var(--ze-released-ink);
  }
  .cms-prose h2,
  .cms-prose h3,
  .cms-prose h4,
  .cms-prose h5,
  .cms-prose h6 {
    color: var(--ze-ink);
    font-weight: 600;
    text-wrap: balance;
  }
  .cms-prose h2 {
    margin: 3.5rem 0 1rem;
    font-size: clamp(1.625rem, 3vw, 1.875rem);
    line-height: 1.2;
    letter-spacing: -0.022em;
  }
  .cms-prose h3 {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.375rem;
    line-height: 1.3;
  }
  .cms-prose h4,
  .cms-prose h5,
  .cms-prose h6 {
    margin: 2rem 0 0.5rem;
  }
  .cms-prose :not(pre) > code {
    border: 1px solid var(--ze-line);
    border-radius: 0.375rem;
    padding: 0.1em 0.35em;
    background: var(--ze-surface-2);
    font-size: 0.84em;
    color: var(--ze-ink);
  }
  .cms-prose blockquote {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--ze-line-strong);
  }
  .cms-prose img {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }
  .cms-prose figure {
    margin: 2rem 0;
  }
  .cms-prose hr {
    margin: 3rem 0;
    border: 0;
    height: 1px;
    background: var(--ze-line);
  }
  .cms-prose table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.875rem;
  }
  .cms-prose th,
  .cms-prose td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--ze-line);
    vertical-align: top;
  }
  .cms-prose th {
    color: var(--ze-ink);
    background: var(--ze-surface-2);
  }
</style>
