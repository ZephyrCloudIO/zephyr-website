{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zephyr-website",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "zephyr-website" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "zephyr-website-media" }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
}
