---
import '@/index.css';
import '@fontsource-variable/chivo-mono';
import '@fontsource-variable/inter/opsz.css';
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from 'emdash/ui';
import { createPublicPageContext } from 'emdash/page';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  robots?: string | null;
  type?: 'website' | 'article';
  content?: { collection: string; id: string; slug?: string };
}

const {
  title,
  description,
  image = '/images/og/default-1200x630.png',
  canonical,
  robots,
  type = 'website',
  content,
} = Astro.props;
const origin = Astro.site ?? new URL('https://zephyr-cloud.io');
const canonicalUrl = canonical ?? new URL(Astro.url.pathname.replace(/\/$/, '') || '/', origin).href;
const imageUrl = new URL(image, origin).href;
const isDefaultImage = imageUrl.endsWith('/images/og/default-1200x630.png');
const imageType = {
  png: 'image/png',
  jpg: 'image/jpeg',
  jpeg: 'image/jpeg',
  webp: 'image/webp',
  svg: 'image/svg+xml',
  gif: 'image/gif',
}[imageUrl.split('.').pop() ?? ''];
const pageContext = createPublicPageContext({
  Astro,
  kind: content ? 'content' : 'custom',
  pageType: type,
  title,
  description,
  canonical: canonicalUrl,
  image: imageUrl,
  content,
  seo: { robots },
  siteName: 'Zephyr Cloud',
  siteUrl: origin.href,
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="theme-color" content="#07080c" />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:image:secure_url" content={imageUrl} />
    {imageType && <meta property="og:image:type" content={imageType} />}
    {isDefaultImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:image:src" content={imageUrl} />
    <script is:inline>
      (function (documentElement) {
        documentElement.dataset.motion = 'on';
        setTimeout(function () {
          if (!window.__zeMotionReady) documentElement.dataset.motion = 'off';
        }, 3000);
      })(document.documentElement);
    </script>
    <EmDashHead page={pageContext} />
  </head>
  <body>
    <EmDashBodyStart page={pageContext} />
    <slot />
    <EmDashBodyEnd page={pageContext} />
  </body>
</html>
